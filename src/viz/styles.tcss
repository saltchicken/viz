/* Main Application Layout */
#main-split {
    height: 1fr;
}

#prep-panel {
    width: 42%;
    height: 1fr;
    border-right: solid $primary;
    padding: 1;
}

#chat-panel {
    width: 58%;
    height: 1fr;
    padding: 1;
}

.section-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#chat-header {
    height: 3;
    margin-bottom: 1;
}

#chat-header-title {
    width: 1fr;
    content-align: left middle;
}

#toggle-container {
    width: auto;
    height: 3;
    align: right middle;
}

#toggle-container Label {
    margin-top: 1;
    margin-left: 1;
    margin-right: 1;
}

#preview-state {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

#preview-image {
    height: 14;
    width: auto;
    border: dashed $secondary;
    margin-bottom: 1;
}

.btn-row {
    height: auto;
    margin-bottom: 1;
}

.btn-row Button {
    width: 1fr;
    margin-right: 1;
}

#prompt-input {
    height: 1fr;
    min-height: 6;
    margin-bottom: 1;
}

#chat-scroll {
    height: 1fr;
    border: solid $secondary;
    padding: 1;
    margin-bottom: 1;
}

/* Chat Message Widgets */
ChatMessage {
    height: auto;
    padding: 1;
    margin-bottom: 1;
}

.user-msg {
    background: $boost;
    border-left: thick $primary;
}

.assistant-msg {
    background: $surface;
    border-left: thick $success;
}

.md-view-container {
    height: auto;
}

.md-chunk {
    height: auto;
    margin-bottom: 0;
}

.inline-copy-btn {
    min-width: 4;
    margin-top: 0;
    margin-bottom: 1;
    border: none;
    height: 1;
    align: right middle;
}

/* FileSelectModal */
FileSelectModal {
    align: center middle;
}

#modal-dialog {
    width: 80%;
    height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

#file-tree {
    height: 1fr;
    border: solid $secondary;
    margin: 1 0;
}

#selected-label {
    height: 3;
    color: $accent;
}

.modal-buttons {
    height: auto;
    align: right middle;
}

FileSelectModal Button {
    margin-left: 1;
}

/* ThinkingModal */
ThinkingModal {
    align: center middle;
}

#thinking-box {
    width: 60;
    height: auto;
    border: heavy $accent;
    background: $surface;
    padding: 2;
    align: center middle;
}

#thinking-text {
    text-align: center;
    margin-bottom: 2;
}
