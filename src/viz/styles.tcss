/* Override global theme variables */

/*
    $primary: #cba6f7;
    $primary-darken-1: #b4befe;

    $success: #a6e3a1;
    $warning: #f9e2af;
    $error: #f38ba8;

    $surface: #313244;
    $surface-lighten-1: #45475a;

App {
    background: #1e1e2e;
    color: #cdd6f4;
}

/* Main Application Layout */
#prep-panel {
    width: 1fr;
    height: 1fr;
    padding: 1;
}

#chat-panel {
    width: 1fr;
    height: 1fr;
    padding: 1;
}

.section-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#chat-header {
    height: 3;
    margin-bottom: 1;
}

#chat-header-title {
    width: 1fr;
    content-align: left middle;
}

#toggle-container {
    width: auto;
    height: 3;
    align: right middle;
}

#toggle-container Label {
    margin-top: 1;
    margin-left: 1;
    margin-right: 1;
}

#preview-state {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

#preview-image {
    height: 14;
    width: auto;
    border: dashed $secondary;
    margin-bottom: 1;
}

.btn-row {
    height: auto;
    margin-bottom: 1;
}

.btn-row Button {
    width: 1fr;
    margin-right: 1;
}

#prompt-input {
    height: 1fr;
    min-height: 6;
    margin-bottom: 1;
}

#chat-scroll {
    height: 1fr;
    border: solid $secondary;
    padding: 1;
    margin-bottom: 1;
}

/* Chat Message Widgets */
ChatMessage {
    height: auto;
    padding: 1;
    margin-bottom: 1;
}

.user-msg {
    background: $boost;
    border-left: thick $primary;
}

.assistant-msg {
    background: $surface;
    border-left: thick $success;
}

.md-view-container {
    height: auto;
}

.md-chunk {
    height: auto;
    margin-bottom: 0;
}

.inline-copy-btn {
    min-width: 4;
    margin-top: 0;
    margin-bottom: 1;
    border: none;
    height: 1;
    align: right middle;
}

/* FileSelectModal */
FileSelectModal {
    align: center middle;
}

#modal-dialog {
    width: 80%;
    height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

#file-tree {
    height: 1fr;
    border: solid $secondary;
    margin: 1 0;
}

#selected-label {
    height: 3;
    color: $accent;
}

.modal-buttons {
    height: auto;
    align: right middle;
}

FileSelectModal Button {
    margin-left: 1;
}

/* DebugModal */
DebugModal {
    align: center middle;
}

#debug-dialog {
    width: 80%;
    height: 80%;
    border: thick $warning;
    background: $surface;
    padding: 1 2;
}

#debug-textarea {
    height: 1fr;
    margin: 1 0;
    border: solid $secondary;
}

/* Styling for system/tool message results */
.tool-msg {
    background: $surface;
    border-left: thick $warning;
}
